{
  "manifest_version": 3,
  "name": "Kawaragi Trigger Worker",
  "version": "2.0",
  "description": "Jembatan anti-blokir & sinkronisasi cookies otomatis untuk Kawaragi Downloader",
  "permissions": [
    "cookies",
    "tabs",
    "alarms",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://localhost:65432/*",
    "http://127.0.0.1:65432/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "logo.png",
    "default_title": "Kawaragi Trigger - Klik untuk Sinkronisasi"
  },
  "icons": {
    "16": "logo.png",
    "48": "logo.png",
    "128": "logo.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}