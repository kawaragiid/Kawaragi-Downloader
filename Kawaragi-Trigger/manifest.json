{
  "manifest_version": 3,
  "name": "Kawaragi Trigger Worker",
  "version": "1.3",
  "description": "Jembatan anti-blokir untuk Kawaragi Downloader",
  "permissions": ["cookies", "tabs", "alarms"],
  "host_permissions": [
    "<all_urls>", 
    "http://localhost:65432/*",
    "http://127.0.0.1:65432/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}