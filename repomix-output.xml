        output_file = f"{base}.{output_format}"
        if input_file.lower() == output_file.lower():
            return input_file

        ffmpeg = get_ffmpeg_path()
        command = [ffmpeg, "-y", "-i", input_file, output_file]
        flags = subprocess.CREATE_NO_WINDOW if os.name == 'nt' else 0
        try:
