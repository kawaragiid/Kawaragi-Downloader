@echo off
title Asisten Pemasangan Ekstensi Kawaragi Trigger
set "EXT_DIR=%~dp0"
if "%EXT_DIR:~-1%"=="\" set "EXT_DIR=%EXT_DIR:~0,-1%"

echo ========================================================
